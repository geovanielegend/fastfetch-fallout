{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
    "source": "hammer.txt",
    "type": "file",
    "color": {
	"1": "#1EDE23",
	"2": "#1EDE23"
	},
    "padding": {
      "top": 1,
      "left": 2
    }
  },
     "modules": [
        "break",
        {
            "type": "custom",
            "format": "┌──────────────────────SYSTEM────────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "#1EDE23"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "disk",
	    "disk_subtitle": "mount",
            "key": "└ └󰋊 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "#1EDE23"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "#1EDE23"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "#1EDE23"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "#1EDE23",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "#1EDE23"
        },
        {
            "type": "custom",
            "format": "└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "square"
        }
    ]
}
